{
  "manifest_version": 3,
  "name": "ESPN Fantasy Connect",
  "version": "1.4.0",
  "description": "Shows your ESPN fantasy cookies so you can copy them yourself.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://espn.com/*",
    "https://*.espn.com/*",
    "https://fantasy.espn.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ESPN Fantasy Connect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/*",
        "https://www.espn.com/fantasy/*",
        "https://espn.com/fantasy/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
